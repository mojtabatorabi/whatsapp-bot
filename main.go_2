package main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"net/http"
	"time"
)

const (
	ollamaURL = "http://localhost:11434/api/chat"
	ollamaModel = "qwen2.5-coder:7b"
)

type Message struct {
	Role    string `json:"role"`
	Content string `json:"content"`
}

type OllamaRequest struct {
	Model    string    `json:"model"`
	Messages []Message `json:"messages"`
	Stream   bool      `json:"stream"`
}

type OllamaResponse struct {
	Message Message `json:"message"`
}

type WhatsAppMessage struct {
	From    string `json:"from"`
	Message string `json:"message"`
}

type WhatsAppResponse struct {
	To      string `json:"to"`
	Message string `json:"message"`
}

func main() {
	http.HandleFunc("/webhook/whatsapp", whatsappWebhook)
	http.HandleFunc("/simulate/send", simulateSend)

	fmt.Println("WhatsApp Bot running on :8080")

	err := http.ListenAndServe(":8080", nil)
	if err != nil {
		panic(err)
	}
}

func whatsappWebhook(w http.ResponseWriter, r *http.Request) {

	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	var whatsappMsg WhatsAppMessage

	err := json.NewDecoder(r.Body).Decode(&whatsappMsg)
	if err != nil {
		http.Error(w, "Invalid JSON", http.StatusBadRequest)
		return
	}

	fmt.Println("=================================")
	fmt.Println("Incoming WhatsApp message")
	fmt.Println("From:", whatsappMsg.From)
	fmt.Println("Message:", whatsappMsg.Message)

	reply, err := askOllama(whatsappMsg.Message)
	if err != nil {
		http.Error(w, "Ollama error: "+err.Error(), http.StatusInternalServerError)
		return
	}

	fmt.Println("Ollama reply:", reply)

	response := WhatsAppResponse{
		To:      whatsappMsg.From,
		Message: reply,
	}

	w.Header().Set("Content-Type", "application/json")

	json.NewEncoder(w).Encode(response)
}

func simulateSend(w http.ResponseWriter, r *http.Request) {

	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	var msg WhatsAppMessage

	err := json.NewDecoder(r.Body).Decode(&msg)
	if err != nil {
		http.Error(w, "Invalid JSON", http.StatusBadRequest)
		return
	}

	jsonData, err := json.Marshal(msg)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	resp, err := http.Post(
		"http://localhost:8080/webhook/whatsapp",
		"application/json",
		bytes.NewBuffer(jsonData),
	)

	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	defer resp.Body.Close()

	var result WhatsAppResponse

	err = json.NewDecoder(resp.Body).Decode(&result)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")

	json.NewEncoder(w).Encode(result)

	time.Sleep(100 * time.Millisecond)
}

func askOllama(prompt string) (string, error) {

	requestBody := OllamaRequest{
		Model: ollamaModel,
		Messages: []Message{
			{
				Role:    "system",
				Content: "You are a helpful WhatsApp assistant. Answer in Persian.",
			},
			{
				Role:    "user",
				Content: prompt,
			},
		},
		Stream: false,
	}

	jsonData, err := json.Marshal(requestBody)
	if err != nil {
		return "", err
	}

	resp, err := http.Post(
		ollamaURL,
		"application/json",
		bytes.NewBuffer(jsonData),
	)

	if err != nil {
		return "", err
	}

	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		return "", fmt.Errorf("Ollama returned %s", resp.Status)
	}

	var result OllamaResponse

	err = json.NewDecoder(resp.Body).Decode(&result)
	if err != nil {
		return "", err
	}

	return result.Message.Content, nil
}
