package main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"net/http"
	"sync"
)

const (
	serverPort = ":8080"

	ollamaURL   = "http://localhost:11434/api/chat"
	ollamaModel = "qwen2.5-coder:7b"

	systemPrompt = "You are a helpful WhatsApp assistant. Always answer in Persian."
)

// =========================
// Message
// =========================

type Message struct {
	Role    string `json:"role"`
	Content string `json:"content"`
}

// =========================
// Ollama Request
// =========================

type OllamaRequest struct {
	Model    string    `json:"model"`
	Messages []Message `json:"messages"`
	Stream   bool      `json:"stream"`
}

// =========================
// Ollama Response
// =========================

type OllamaResponse struct {
	Message Message `json:"message"`
}

// =========================
// WhatsApp Message
// =========================

type WhatsAppMessage struct {
	From    string `json:"from"`
	Message string `json:"message"`
}

// =========================
// WhatsApp Response
// =========================

type WhatsAppResponse struct {
	To      string `json:"to"`
	Message string `json:"message"`
}

// =========================
// Conversation
// =========================

type Conversation struct {
	Messages []Message `json:"messages"`
}

// =========================
// In-Memory Database
// =========================

var (
	conversations = make(map[string]*Conversation)

	conversationsMutex sync.RWMutex
)

// ============================================================
// MAIN
// ============================================================

func main() {

	// WhatsApp webhook
	http.HandleFunc(
		"/webhook/whatsapp",
		whatsappWebhook,
	)

	// Fake WhatsApp sender
	http.HandleFunc(
		"/simulate/send",
		simulateSend,
	)

	// Health check
	http.HandleFunc(
		"/health",
		healthHandler,
	)

	// Show conversation memory
	http.HandleFunc(
		"/memory",
		memoryHandler,
	)

	// Clear conversation
	http.HandleFunc(
		"/memory/clear",
		clearMemoryHandler,
	)

	fmt.Println("=================================")
	fmt.Println("WhatsApp AI Bot")
	fmt.Println("=================================")
	fmt.Println("Server:", serverPort)
	fmt.Println("Ollama:", ollamaURL)
	fmt.Println("Model :", ollamaModel)
	fmt.Println("=================================")

	err := http.ListenAndServe(
		serverPort,
		nil,
	)

	if err != nil {
		panic(err)
	}
}

// ============================================================
// HEALTH CHECK
// ============================================================

func healthHandler(
	w http.ResponseWriter,
	r *http.Request,
) {

	w.Header().Set(
		"Content-Type",
		"application/json",
	)

	response := map[string]interface{}{
		"status": "ok",
		"service": "whatsapp-ai-bot",
		"ollama": ollamaURL,
		"model": ollamaModel,
	}

	json.NewEncoder(w).Encode(response)
}

// ============================================================
// WHATSAPP WEBHOOK
// ============================================================

func whatsappWebhook(
	w http.ResponseWriter,
	r *http.Request,
) {

	if r.Method != http.MethodPost {

		http.Error(
			w,
			"Method not allowed",
			http.StatusMethodNotAllowed,
		)

		return
	}

	var whatsappMsg WhatsAppMessage

	err := json.NewDecoder(
		r.Body,
	).Decode(&whatsappMsg)

	if err != nil {

		http.Error(
			w,
			"Invalid JSON",
			http.StatusBadRequest,
		)

		return
	}

	if whatsappMsg.From == "" {

		http.Error(
			w,
			"Missing 'from'",
			http.StatusBadRequest,
		)

		return
	}

	if whatsappMsg.Message == "" {

		http.Error(
			w,
			"Missing 'message'",
			http.StatusBadRequest,
		)

		return
	}

	fmt.Println()
	fmt.Println("=================================")
	fmt.Println("Incoming WhatsApp message")
	fmt.Println("From   :", whatsappMsg.From)
	fmt.Println("Message:", whatsappMsg.Message)

	// ------------------------------------------------
	// Get user's conversation
	// ------------------------------------------------

	conversation := getConversation(
		whatsappMsg.From,
	)

	// ------------------------------------------------
	// Add system prompt
	// ------------------------------------------------

	addSystemPrompt(conversation)

	// ------------------------------------------------
	// Add user message
	// ------------------------------------------------

	addMessage(
		conversation,
		Message{
			Role:    "user",
			Content: whatsappMsg.Message,
		},
	)

	// ------------------------------------------------
	// Send conversation to Ollama
	// ------------------------------------------------

	reply, err := askOllama(
		conversation.Messages,
	)

	if err != nil {

		fmt.Println(
			"Ollama error:",
			err,
		)

		http.Error(
			w,
			"Ollama error: "+err.Error(),
			http.StatusInternalServerError,
		)

		return
	}

	// ------------------------------------------------
	// Save assistant response
	// ------------------------------------------------

	addMessage(
		conversation,
		Message{
			Role:    "assistant",
			Content: reply,
		},
	)

	fmt.Println("Ollama reply:", reply)

	fmt.Println("=================================")

	// ------------------------------------------------
	// Return WhatsApp response
	// ------------------------------------------------

	response := WhatsAppResponse{
		To:      whatsappMsg.From,
		Message: reply,
	}

	w.Header().Set(
		"Content-Type",
		"application/json",
	)

	json.NewEncoder(w).Encode(
		response,
	)
}

// ============================================================
// GET /simulate/send
// ============================================================

func simulateSend(
	w http.ResponseWriter,
	r *http.Request,
) {

	if r.Method != http.MethodPost {

		http.Error(
			w,
			"Method not allowed",
			http.StatusMethodNotAllowed,
		)

		return
	}

	var message WhatsAppMessage

	err := json.NewDecoder(
		r.Body,
	).Decode(&message)

	if err != nil {

		http.Error(
			w,
			"Invalid JSON",
			http.StatusBadRequest,
		)

		return
	}

	// ------------------------------------------------
	// Convert request to JSON
	// ------------------------------------------------

	jsonData, err := json.Marshal(
		message,
	)

	if err != nil {

		http.Error(
			w,
			err.Error(),
			http.StatusInternalServerError,
		)

		return
	}

	// ------------------------------------------------
	// Send message to our own webhook
	// ------------------------------------------------

	resp, err := http.Post(
		"http://localhost:8080/webhook/whatsapp",
		"application/json",
		bytes.NewBuffer(jsonData),
	)

	if err != nil {

		http.Error(
			w,
			err.Error(),
			http.StatusInternalServerError,
		)

		return
	}

	defer resp.Body.Close()

	// ------------------------------------------------
	// Read webhook response
	// ------------------------------------------------

	var result WhatsAppResponse

	err = json.NewDecoder(
		resp.Body,
	).Decode(&result)

	if err != nil {

		http.Error(
			w,
			err.Error(),
			http.StatusInternalServerError,
		)

		return
	}

	w.Header().Set(
		"Content-Type",
		"application/json",
	)

	json.NewEncoder(w).Encode(
		result,
	)
}

// ============================================================
// GET /memory?user=989121234567
// ============================================================

func memoryHandler(
	w http.ResponseWriter,
	r *http.Request,
) {

	userID := r.URL.Query().Get(
		"user",
	)

	if userID == "" {

		http.Error(
			w,
			"Missing user parameter",
			http.StatusBadRequest,
		)

		return
	}

	conversationsMutex.RLock()

	conversation, exists := conversations[userID]

	if !exists {

		conversationsMutex.RUnlock()

		http.Error(
			w,
			"Conversation not found",
			http.StatusNotFound,
		)

		return
	}

	// Copy messages so we don't hold lock while encoding
	messages := append(
		[]Message(nil),
		conversation.Messages...,
	)

	conversationsMutex.RUnlock()

	w.Header().Set(
		"Content-Type",
		"application/json",
	)

	json.NewEncoder(w).Encode(
		map[string]interface{}{
			"user":     userID,
			"messages": messages,
		},
	)
}

// ============================================================
// DELETE /memory/clear?user=989121234567
// ============================================================

func clearMemoryHandler(
	w http.ResponseWriter,
	r *http.Request,
) {

	if r.Method != http.MethodDelete {

		http.Error(
			w,
			"Method not allowed",
			http.StatusMethodNotAllowed,
		)

		return
	}

	userID := r.URL.Query().Get(
		"user",
	)

	if userID == "" {

		http.Error(
			w,
			"Missing user parameter",
			http.StatusBadRequest,
		)

		return
	}

	conversationsMutex.Lock()

	delete(
		conversations,
		userID,
	)

	conversationsMutex.Unlock()

	w.Header().Set(
		"Content-Type",
		"application/json",
	)

	json.NewEncoder(w).Encode(
		map[string]interface{}{
			"success": true,
			"user":    userID,
			"message": "Conversation cleared",
		},
	)
}

// ============================================================
// GET /getConversation
// ============================================================

func getConversation(
	userID string,
) *Conversation {

	conversationsMutex.Lock()

	defer conversationsMutex.Unlock()

	conversation, exists := conversations[userID]

	if !exists {

		conversation = &Conversation{
			Messages: []Message{},
		}

		conversations[userID] = conversation
	}

	return conversation
}

// ============================================================
// ADD SYSTEM PROMPT
// ============================================================

func addSystemPrompt(
	conversation *Conversation,
) {

	if len(conversation.Messages) == 0 {

		conversation.Messages = append(
			conversation.Messages,
			Message{
				Role:    "system",
				Content: systemPrompt,
			},
		)
	}
}

// ============================================================
// ADD MESSAGE
// ============================================================

func addMessage(
	conversation *Conversation,
	message Message,
) {

	conversationsMutex.Lock()

	defer conversationsMutex.Unlock()

	conversation.Messages = append(
		conversation.Messages,
		message,
	)

	// ------------------------------------------------
	// Limit memory
	// ------------------------------------------------

	const maxMessages = 21

	if len(conversation.Messages) > maxMessages {

		// Keep system message
		systemMessage := conversation.Messages[0]

		recentMessages := conversation.Messages[
			len(conversation.Messages)-20:
		]

		conversation.Messages = append(
			[]Message{systemMessage},
			recentMessages...,
		)
	}
}

// ============================================================
// OLLAMA
// ============================================================

func askOllama(
	messages []Message,
) (string, error) {

	requestBody := OllamaRequest{
		Model: ollamaModel,

		Messages: messages,

		Stream: false,
	}

	// ------------------------------------------------
	// Convert to JSON
	// ------------------------------------------------

	jsonData, err := json.Marshal(
		requestBody,
	)

	if err != nil {
		return "", err
	}

	// ------------------------------------------------
	// HTTP POST to Ollama
	// ------------------------------------------------

	resp, err := http.Post(
		ollamaURL,
		"application/json",
		bytes.NewBuffer(jsonData),
	)

	if err != nil {
		return "", err
	}

	defer resp.Body.Close()

	// ------------------------------------------------
	// Check HTTP status
	// ------------------------------------------------

	if resp.StatusCode != http.StatusOK {

		return "",
			fmt.Errorf(
				"Ollama returned %s",
				resp.Status,
			)
	}

	// ------------------------------------------------
	// Parse response
	// ------------------------------------------------

	var result OllamaResponse

	err = json.NewDecoder(
		resp.Body,
	).Decode(&result)

	if err != nil {
		return "", err
	}

	return result.Message.Content, nil
}
